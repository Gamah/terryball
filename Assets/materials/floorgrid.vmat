// Tiled checker floor so the ball's roll speed is readable.
// Uses the engine's dev checkerboard texture (which exists at runtime) and a high
// TexCoordScale so the pattern REPEATS across the large floor instead of stretching
// once across it. Raise/lower g_vTexCoordScale to make the cells smaller/larger.
"Layer0"
{
	"shader"		"shaders/generic.shader_c"
	"TextureColor"		"textures/dev/checkerboard.vtex"
	"g_vColorTint"		"[1.000000 1.000000 1.000000 0.000000]"
	"g_vTexCoordOffset"		"[0.000 0.000]"
	"g_vTexCoordScale"		"[256.000 256.000]"
}
