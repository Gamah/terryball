@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using System.Collections.Generic;
@using Terryball;
@inherits PanelComponent

@*
	Top-right ten-frame scoreboard, the way an alley monitor shows it: a row per player (one for
	now) with each frame's ball marks (X strike, / spare, - miss) in little boxes above its running
	cumulative total, the 10th frame carrying three boxes for its bonus ball. All the scoring lives
	in GameDirector.BuildScoreView(); this panel just lays it out. Press P (handled by the director)
	to start a fresh game.
*@

<root style="position: absolute; top: 24px; right: 24px; flex-direction: column;
             padding: 14px 16px; background-color: rgba(0,0,0,0.62); border-radius: 10px;
             font-family: Poppins, sans-serif; color: white;
             display: @(IsJoined ? "flex" : "none");">
	@{
		var director = Director;
		var players = director?.BuildScoreView() ?? new List<GameDirector.PlayerView>();
		var over = director?.GameOver ?? false;
		var practice = director?.Mode == GameDirector.LaneMode.Practice;
	}

	@if ( practice )
	{
		@* Practice: the scorecard is moot — show a PRACTICE MODE banner + the live throw queue (front =
		   current bowler, highlighted) instead of the ten-frame grid. *@
		<div style="flex-direction: row; align-items: center; margin-bottom: 8px;">
			<div style="font-size: 18px; font-weight: 800; letter-spacing: 3px; color: #b07cd6;
			            flex-grow: 1;">PRACTICE MODE</div>
			<div style="font-size: 11px; color: rgba(255,255,255,0.5); font-weight: 600;">
				@director.Drill.ToString().ToUpper()
			</div>
		</div>
		@{ var queue = director.RosterNames?.ToList() ?? new List<string>(); }
		@if ( queue.Count == 0 )
		{
			<div style="font-size: 13px; color: rgba(255,255,255,0.45);">Waiting for bowlers — get in line at the lane.</div>
		}
		@for ( var qi = 0; qi < queue.Count; qi++ )
		{
			var current = qi == director.CurrentPlayer;
			<div style="flex-direction: row; align-items: center; margin-bottom: 3px; padding: 3px 6px;
			            border-radius: 5px;
			            background-color: @(current ? "rgba(241,196,15,0.16)" : "transparent");">
				<div style="width: 22px; font-size: 13px; font-weight: 800;
				            color: @(current ? "#f1c40f" : "rgba(255,255,255,0.4)");">@(qi + 1)</div>
				<div style="font-size: 14px; font-weight: 700;
				            color: @(current ? "#f1c40f" : "white");">@queue[qi]</div>
			</div>
		}
	}
	else
	{
	<div style="flex-direction: row; align-items: center; margin-bottom: 8px;">
		<div style="font-size: 18px; font-weight: 700; flex-grow: 1;">SCOREBOARD</div>
		<div style="font-size: 11px; color: @(over ? "#f1c40f" : "rgba(255,255,255,0.5)");
		            font-weight: 600;">@(over ? "GAME OVER — press P" : "press P to reset")</div>
	</div>

	@foreach ( var player in players )
	{
		<div style="flex-direction: row; align-items: stretch; margin-bottom: 4px;
		            @(player.Active ? "" : "opacity: 0.85;")">

			@* Player name *@
			<div style="width: 78px; justify-content: center; padding-right: 8px; font-size: 13px;
			            font-weight: 600;">@player.Name</div>

			@* Ten frame cells *@
			@for ( var fr = 0; fr < player.Frames.Count; fr++ )
			{
				var frame = player.Frames[fr];
				var tenth = fr == 9;
				<div style="flex-direction: column; width: @(tenth ? "72px" : "46px");
				            border-left-width: 1px; border-color: rgba(255,255,255,0.18);
				            background-color: @(frame.Active ? "rgba(241,196,15,0.18)" : "transparent");">

					@* Frame number *@
					<div style="font-size: 9px; color: rgba(255,255,255,0.4); align-items: center;
					            justify-content: center; padding-top: 2px;">@(fr + 1)</div>

					@* Ball-mark boxes — a split count is circled (border-radius) in amber, alley-style *@
					<div style="flex-direction: row; justify-content: flex-end; padding: 0px 3px;">
						@for ( var bi = 0; bi < frame.Balls.Count; bi++ )
						{
							var split = frame.SplitBalls.Contains( bi );
							<div style="width: 20px; height: 20px; margin-left: 1px;
							            align-items: center; justify-content: center; font-size: 13px;
							            font-weight: 700; color: white;
							            border-width: @(split ? "2px" : "1px");
							            border-color: @(split ? "#f1c40f" : "rgba(255,255,255,0.14)");
							            border-radius: @(split ? "10px" : "0px");">
								@frame.Balls[bi]
							</div>
						}
					</div>

					@* Running cumulative total *@
					<div style="height: 22px; align-items: center; justify-content: center;
					            font-size: 14px; font-weight: 700;">
						@(frame.Score.HasValue ? frame.Score.Value.ToString() : "")
					</div>
				</div>
			}

			@* Grand total *@
			<div style="flex-direction: column; width: 52px; justify-content: center;
			            align-items: center; padding-left: 8px;">
				<div style="font-size: 9px; color: rgba(255,255,255,0.4);">TOTAL</div>
				<div style="font-size: 20px; font-weight: 800;">@player.Total</div>
			</div>
		</div>
	}
	}
</root>

@code
{
	// The HUD is client-local (not under a lane), so it shows the lane the local player has joined.
	private GameDirector Director => Lane.ForLocalPlayer( Scene )?.Director;

	// Only draw for a player signed in to a lane — a lobby spectator gets no scoreboard on their screen.
	private bool IsJoined => TerryAvatar.Local( Scene )?.Joined ?? false;

	// Rebuild whenever the marks, totals, current frame or game-over state could have changed.
	protected override int BuildHash()
	{
		var director = Director;
		if ( director is null ) return IsJoined ? 1 : 0;

		var hash = new System.HashCode();
		hash.Add( IsJoined );
		hash.Add( director.GameOver );
		hash.Add( director.Mode );
		hash.Add( director.Drill );
		hash.Add( director.CurrentPlayer );
		hash.Add( director.ActiveBowlerId ); // idle (empty queue) vs someone up
		foreach ( var name in director.RosterNames )
			hash.Add( name );
		foreach ( var player in director.BuildScoreView() )
		{
			hash.Add( player.Name );
			hash.Add( player.Active );
			hash.Add( player.Total );
			foreach ( var frame in player.Frames )
			{
				hash.Add( frame.Active );
				hash.Add( frame.Score );
				hash.Add( frame.SplitBalls.Count );
				foreach ( var mark in frame.Balls )
					hash.Add( mark );
			}
		}
		return hash.ToHashCode();
	}
}
