@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using System.Collections.Generic;
@using Terryball;
@inherits PanelComponent

@*
	The in-world lane monitor — the overhead screen at the settee (the seating area behind the
	lane). It shows THIS lane's scorecard for every player, the way an alley monitor does, and
	reserves space for the lane controls (settings, players joining/leaving). Built to be read in
	3D off a WorldPanel, so everything here is sized bigger than the corner ScreenPanel scoreboard.

	Multiplayer note: the layout already iterates ALL players from the director and flags whose turn
	it is, so seating more bowlers is a data change, not a rewrite. The control strip along the
	bottom is deliberately INERT for now — buttons are drawn so there's a home for Settings / Join /
	Leave, but nothing is wired up yet (per the brief: "make room for it").
*@

<root style="width: 1200px; height: 675px; flex-direction: column;
             font-family: Poppins, sans-serif; color: white;
             background-color: rgba(8,10,16,0.96); border-radius: 18px;
             border-width: 4px; border-color: rgba(90,150,220,0.55); padding: 22px 28px;">
	@{
		var director = Director;
		var players = director?.BuildScoreView() ?? new List<GameDirector.PlayerView>();
		var over = director?.GameOver ?? false;
	}

	@* ---- Header: lane label + game state ---- *@
	<div style="flex-direction: row; align-items: center; margin-bottom: 14px;">
		<div style="font-size: 40px; font-weight: 800; flex-grow: 1; letter-spacing: 2px;">
			LANE <span style="color: #5aa0e6;">1</span>
		</div>
		<div style="font-size: 22px; font-weight: 700;
		            color: @(over ? "#f1c40f" : "rgba(255,255,255,0.45)");">
			@(over ? "GAME OVER" : "IN PLAY")
		</div>
	</div>

	@* ---- Scorecard: one row per player ---- *@
	<div style="flex-direction: column; flex-grow: 1;">
		@foreach ( var player in players )
		{
			<div style="flex-direction: row; align-items: stretch; margin-bottom: 8px;
			            background-color: @(player.Active ? "rgba(241,196,15,0.12)" : "rgba(255,255,255,0.03)");
			            border-radius: 8px; padding: 4px;">

				@* Player name + grand total *@
				<div style="width: 200px; flex-direction: column; justify-content: center;
				            padding-left: 12px;">
					<div style="font-size: 24px; font-weight: 700;">@player.Name</div>
					<div style="font-size: 16px; color: rgba(255,255,255,0.5);">
						TOTAL <span style="font-size: 28px; font-weight: 800; color: white;">@player.Total</span>
					</div>
				</div>

				@* Ten frame cells *@
				@for ( var fr = 0; fr < player.Frames.Count; fr++ )
				{
					var frame = player.Frames[fr];
					var tenth = fr == 9;
					<div style="flex-direction: column; width: @(tenth ? "108px" : "72px");
					            border-left-width: 1px; border-color: rgba(255,255,255,0.15);
					            background-color: @(frame.Active ? "rgba(241,196,15,0.20)" : "transparent");">

						@* Frame number *@
						<div style="font-size: 14px; color: rgba(255,255,255,0.4);
						            align-items: center; justify-content: center; padding-top: 2px;">@(fr + 1)</div>

						@* Ball-mark boxes *@
						<div style="flex-direction: row; justify-content: flex-end; padding: 0px 4px;">
							@foreach ( var mark in frame.Balls )
							{
								<div style="width: 30px; height: 30px; margin-left: 2px;
								            align-items: center; justify-content: center; font-size: 22px;
								            font-weight: 700; color: white;
								            border-width: 1px; border-color: rgba(255,255,255,0.16);">
									@mark
								</div>
							}
						</div>

						@* Running cumulative total *@
						<div style="height: 34px; align-items: center; justify-content: center;
						            font-size: 24px; font-weight: 700;">
							@(frame.Score.HasValue ? frame.Score.Value.ToString() : "")
						</div>
					</div>
				}
			</div>
		}
	</div>

	@* ---- Control strip: placeholders only, nothing wired yet ---- *@
	<div style="flex-direction: row; align-items: center; margin-top: 14px; padding-top: 14px;
	            border-top-width: 2px; border-color: rgba(255,255,255,0.12);">
		<div style="font-size: 16px; color: rgba(255,255,255,0.35); flex-grow: 1;">
			LANE CONTROLS — coming soon
		</div>
		@foreach ( var label in new[] { "Settings", "Add Player", "Join", "Leave" } )
		{
			<div style="margin-left: 10px; padding: 10px 20px; border-radius: 8px;
			            background-color: rgba(255,255,255,0.06);
			            border-width: 1px; border-color: rgba(255,255,255,0.15);
			            font-size: 18px; font-weight: 600; color: rgba(255,255,255,0.6);">
				@label
			</div>
		}
	</div>
</root>

@code
{
	private GameDirector Director => Scene?.GetAllComponents<GameDirector>().FirstOrDefault();

	// Rebuild whenever the marks, totals, current frame or game-over state could have changed.
	protected override int BuildHash()
	{
		var director = Director;
		if ( director is null ) return 0;

		var hash = new System.HashCode();
		hash.Add( director.GameOver );
		foreach ( var player in director.BuildScoreView() )
		{
			hash.Add( player.Active );
			hash.Add( player.Total );
			foreach ( var frame in player.Frames )
			{
				hash.Add( frame.Active );
				hash.Add( frame.Score );
				foreach ( var mark in frame.Balls )
					hash.Add( mark );
			}
		}
		return hash.ToHashCode();
	}
}
