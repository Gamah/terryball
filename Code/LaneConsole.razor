@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using System.Collections.Generic;
@using Terryball;
@inherits PanelComponent

@*
	The in-world lane monitor — the overhead screen at the settee (the seating area behind the
	lane). It shows THIS lane's scorecard for every player, the way an alley monitor does. Built to be
	read in 3D off a WorldPanel, so everything here is sized bigger than the corner ScreenPanel scoreboard.

	The layout iterates every player from the director and flags whose turn it is. The control strip
	along the bottom is inert: its buttons are drawn but not wired to anything.
*@

<root style="width: 1200px; height: 675px; flex-direction: column;
             font-family: Poppins, sans-serif; color: white;
             background-color: @WorldTheme.BgSolid; border-radius: 18px;
             border-width: 4px; border-color: rgba(90,150,220,0.55); padding: 22px 28px;">
	@{
		var director = Director;
		var players = director?.BuildScoreView() ?? new List<GameDirector.PlayerView>();
		var over = director?.GameOver ?? false;
		var practice = director?.Mode == GameDirector.LaneMode.Practice;
	}

	@* ---- Header: lane label + game state ---- *@
	<div style="flex-direction: row; align-items: center; margin-bottom: 10px;">
		<div style="font-size: 28px; font-weight: 800; flex-grow: 1; letter-spacing: 2px;">
			LANE <span style="color: #5aa0e6;">@LaneNumber</span>
		</div>
		<div style="font-size: 16px; font-weight: 700;
		            color: @(practice ? "#b07cd6" : (over ? WorldTheme.AccentCss : "rgba(255,255,255,0.45)"));">
			@(practice ? "PRACTICE" : (over ? "GAME OVER" : "IN PLAY"))
		</div>
	</div>

	@if ( practice )
	{
		@* Practice: the scorecard is moot — a PRACTICE MODE banner + the live throw queue (front = current
		   bowler, highlighted) replaces the ten-frame grid. *@
		<div style="flex-direction: column; flex-grow: 1;">
			<div style="flex-direction: row; align-items: center; margin-bottom: 14px;">
				<div style="font-size: 34px; font-weight: 800; letter-spacing: 5px; color: #b07cd6;
				            padding: 10px 20px; border-radius: 10px;
				            background-color: rgba(155,89,182,0.16);
				            border-width: 2px; border-color: rgba(155,89,182,0.4);">
					PRACTICE MODE
				</div>
				<div style="flex-grow: 1;"></div>
				<div style="font-size: 20px; font-weight: 700; color: rgba(255,255,255,0.55);
				            align-items: center;">
					<span>DRILL: </span><span style="color: #b07cd6;">@director.Drill.ToString().ToUpper()</span>
				</div>
			</div>
			<div style="font-size: 16px; color: rgba(255,255,255,0.4); margin-bottom: 10px;
			            letter-spacing: 3px;">THROW QUEUE</div>
			@{ var queue = director.RosterNames?.ToList() ?? new List<string>(); }
			@if ( queue.Count == 0 )
			{
				<div style="font-size: 20px; color: rgba(255,255,255,0.45); padding: 8px 4px;">
					Waiting for bowlers — get in line at the lane controls.
				</div>
			}
			@for ( var qi = 0; qi < queue.Count; qi++ )
			{
				var current = qi == director.CurrentPlayer;
				<div style="flex-direction: row; align-items: center; margin-bottom: 6px; padding: 8px 16px;
				            border-radius: 8px;
				            background-color: @(current ? WorldTheme.AccentBg : "rgba(255,255,255,0.03)");">
					<div style="width: 46px; font-size: 22px; font-weight: 800;
					            color: @(current ? WorldTheme.AccentCss : "rgba(255,255,255,0.45)");">@(qi + 1)</div>
					<div style="flex-grow: 1; font-size: 24px; font-weight: 700;
					            color: @(current ? WorldTheme.AccentCss : "white");">@queue[qi]</div>
					@if ( current )
					{
						<div style="font-size: 16px; font-weight: 800; letter-spacing: 3px;
						            color: @WorldTheme.AccentCss;">UP</div>
					}
				</div>
			}
		</div>
	}
	else
	{
	@* ---- Scorecard: one row per player ---- *@
	<div style="flex-direction: column; flex-grow: 1;">
		@foreach ( var player in players )
		{
			<div style="flex-direction: row; align-items: stretch; margin-bottom: 6px;
			            background-color: @(player.Active ? "rgba(241,196,15,0.12)" : "rgba(255,255,255,0.03)");
			            border-radius: 8px; padding: 3px;">

				@* Player name + grand total *@
				<div style="width: 150px; flex-direction: column; justify-content: center;
				            padding-left: 10px;">
					<div style="font-size: 18px; font-weight: 700;">@player.Name</div>
					<div style="font-size: 12px; color: rgba(255,255,255,0.5);">
						TOTAL <span style="font-size: 20px; font-weight: 800; color: white;">@player.Total</span>
					</div>
				</div>

				@* Ten frame cells *@
				@for ( var fr = 0; fr < player.Frames.Count; fr++ )
				{
					var frame = player.Frames[fr];
					var tenth = fr == 9;
					<div style="flex-direction: column; width: @(tenth ? "78px" : "54px");
					            border-left-width: 1px; border-color: rgba(255,255,255,0.15);
					            background-color: @(frame.Active ? "rgba(241,196,15,0.20)" : "transparent");">

						@* Frame number *@
						<div style="font-size: 11px; color: rgba(255,255,255,0.4);
						            align-items: center; justify-content: center; padding-top: 2px;">@(fr + 1)</div>

						@* Ball-mark boxes — a split count is circled (border-radius) in amber, alley-style *@
						<div style="flex-direction: row; justify-content: flex-end; padding: 0px 3px;">
							@for ( var bi = 0; bi < frame.Balls.Count; bi++ )
							{
								var split = frame.SplitBalls.Contains( bi );
								<div style="width: 22px; height: 22px; margin-left: 2px;
								            align-items: center; justify-content: center; font-size: 15px;
								            font-weight: 700; color: white;
								            border-width: @(split ? "2px" : "1px");
								            border-color: @(split ? WorldTheme.AccentCss : "rgba(255,255,255,0.16)");
								            border-radius: @(split ? "11px" : "0px");">
									@frame.Balls[bi]
								</div>
							}
						</div>

						@* Running cumulative total *@
						<div style="height: 26px; align-items: center; justify-content: center;
						            font-size: 17px; font-weight: 700;">
							@(frame.Score.HasValue ? frame.Score.Value.ToString() : "")
						</div>
					</div>
				}
			</div>
		}
	</div>
	}

	@* ---- Control strip: inert placeholders ---- *@
	<div style="flex-direction: row; align-items: center; margin-top: 14px; padding-top: 14px;
	            border-top-width: 2px; border-color: rgba(255,255,255,0.12);">
		<div style="font-size: 16px; color: rgba(255,255,255,0.35); flex-grow: 1;">
			LANE CONTROLS — coming soon
		</div>
		@foreach ( var label in new[] { "Settings", "Add Player", "Join", "Leave" } )
		{
			<div style="margin-left: 10px; padding: 10px 20px; border-radius: 8px;
			            background-color: rgba(255,255,255,0.06);
			            border-width: 1px; border-color: rgba(255,255,255,0.15);
			            font-size: 18px; font-weight: 600; color: rgba(255,255,255,0.6);">
				@label
			</div>
		}
	</div>
</root>

@code
{
	private GameDirector Director => Lane.Of( this )?.Director;

	// 1-based lane number in stable left-to-right order, so each lane's monitor reads "LANE n".
	private int LaneNumber => (Lane.Of( this )?.Index ?? 0) + 1;

	// Rebuild whenever the marks, totals, current frame or game-over state could have changed.
	protected override int BuildHash()
	{
		var director = Director;
		if ( director is null ) return WorldTheme.Hash; // still re-render an empty console on a theme change

		var hash = new System.HashCode();
		hash.Add( WorldTheme.Hash ); // re-render the moment the world theme changes, not on the next score
		hash.Add( director.GameOver );
		hash.Add( director.Mode );
		hash.Add( director.Drill );
		hash.Add( director.CurrentPlayer );
		hash.Add( director.ActiveBowlerId ); // idle (empty queue) vs someone up
		foreach ( var name in director.RosterNames )
			hash.Add( name );
		foreach ( var player in director.BuildScoreView() )
		{
			hash.Add( player.Name );
			hash.Add( player.Active );
			hash.Add( player.Total );
			foreach ( var frame in player.Frames )
			{
				hash.Add( frame.Active );
				hash.Add( frame.Score );
				hash.Add( frame.SplitBalls.Count );
				foreach ( var mark in frame.Balls )
					hash.Add( mark );
			}
		}
		return hash.ToHashCode();
	}
}
