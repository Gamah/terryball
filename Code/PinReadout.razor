@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using System.Collections.Generic;
@using Terryball;
@inherits PanelComponent

@*
	The BIG pin readout — a lane-width board mounted above the backstop, facing back at the bowler so
	the standing/down rack is legible from the approach. It's the same data as the corner
	PinStatusOverlay (GameDirector.RackRows + director.IsPinDown), just rendered LARGE to fill a
	WorldPanel: head pin at the bottom, back row at the top, green standing / red down.
*@

<root style="width: 100%; height: 100%; flex-direction: column; align-items: center;
             justify-content: center; padding: 40px;
             font-family: Poppins, sans-serif; color: white;
             background-color: rgba(6,8,12,0.92); border-radius: 24px;
             border-width: 6px; border-color: rgba(90,150,220,0.45);">
	@{
		var director = Director;
		var watching = director?.State == GameDirector.RoundState.Watching;
	}

	@* The exact layout of the corner PinStatusOverlay, just scaled up uniformly (~3.4×): title over
	   count over the rack triangle, all stacked in the root's column. flex-shrink: 0 keeps the rows from
	   being squished to fit, and the column header keeps the text from overflowing the board's width. *@
	<div style="font-size: 90px; font-weight: 700; margin-bottom: 30px; flex-shrink: 0; white-space: nowrap;">
		@(watching ? "WATCHING" : "PINS")
	</div>

	@foreach ( var row in GameDirector.RackRows )
	{
		<div style="flex-direction: row; justify-content: center; flex-shrink: 0;">
			@foreach ( var n in row )
			{
				var isDown = director?.IsPinDown( n ) ?? false;
				<div style="width: 116px; height: 116px; margin: 13px; border-radius: 58px; flex-shrink: 0;
				            align-items: center; justify-content: center; font-size: 54px;
				            font-weight: 600; color: @(isDown ? "rgba(255,255,255,0.55)" : "black");
				            background-color: @(isDown ? "#c0392b" : "#2ecc71");">
					@n
				</div>
			}
		</div>
	}
</root>

@code
{
	private GameDirector Director => Lane.Of( this )?.Director;

	// Rebuild whenever the round state or the set of downed pins changes.
	protected override int BuildHash()
	{
		var director = Director;
		var mask = 0;
		if ( director is not null )
			foreach ( var s in director.PinStatuses )
				if ( s.Down ) mask |= 1 << s.Number;
		return System.HashCode.Combine( director?.State, mask );
	}
}
