@using Sandbox
@using Sandbox.UI
@using System.Linq
@using Terryball
@inherits PanelComponent

@*
	The MORE screen. Walking up to the MORE podium on the spawn concourse and pressing E opens this
	(TerryAvatar runs the engage / cursor-free, like the other podiums). It is where every outbound
	link lives: the Discord invite, the page listing our other s&box games, and the Skafinity repo
	(the library that writes the music).

	EVERY LINK PRINTS ITS URL IN FULL and copies on click. There is no documented API to open a URL
	or the Steam overlay from game code — Clipboard.SetText is the whole toolbox — so a link a player
	cannot copy is one they have to TYPE, and they can only type what they can read. That is why none
	is ever shortened for display: what is on screen and what lands on the clipboard have to be the
	same characters.

	Themed from WorldTheme like every other panel here, so it follows the SETTINGS podium's swatch.
	Pointer-events: none except the modal and its buttons, like LaneControls/TeleportPanel.
*@

<root style="position: absolute; width: 100%; height: 100%; pointer-events: none;
             font-family: Poppins, sans-serif; color: white;">
	@{
		var me = LocalAvatar;
	}

	@if ( me is not null )
	{
		@* Walk-up prompt: near the MORE podium but not engaged yet. *@
		@if ( me.NearMore && !me.MoreOpen )
		{
			<div style="position: absolute; bottom: 64px; left: 0px; right: 0px;
			            flex-direction: row; justify-content: center;">
				<div style="font-size: 22px; font-weight: 700; padding: 10px 24px; border-radius: 10px;
				            background-color: @WorldTheme.Bg;
				            border-width: 1px; border-color: @WorldTheme.Border;">
					Press <span style="color: @WorldTheme.AccentCss; font-weight: 800;">E</span> — More
				</div>
			</div>
		}

		@if ( me.MoreOpen )
		{
			<div style="position: absolute; width: 100%; height: 100%;
			            flex-direction: column; align-items: center; justify-content: center;">
				<div style="pointer-events: all; flex-direction: column; width: 620px;
				            padding: 28px 32px; border-radius: 18px;
				            background-color: @WorldTheme.BgSolid;
				            border-width: 2px; border-color: @WorldTheme.Border;">

					<div style="font-size: 28px; font-weight: 800; letter-spacing: 1px; margin-bottom: 6px;
					            color: @WorldTheme.Text;">
						MORE
					</div>
					<div style="font-size: 15px; margin-bottom: 20px; color: @WorldTheme.TextFaint;">
						Copying is all a game can do — s&amp;box gives no way to open a browser from in here, so paste these somewhere yourself.
					</div>

					<div style="font-size: 17px; font-weight: 800; letter-spacing: 1px; margin-bottom: 6px;
					            color: @WorldTheme.AccentCss;">
						DISCORD
					</div>
					<div style="font-size: 14px; margin-bottom: 8px; color: @WorldTheme.TextDim;">
						The community for terryball and the rest of our games — bug reports, ideas, and whoever is playing tonight.
					</div>
					<div style="font-size: 15px; margin-bottom: 10px; color: @WorldTheme.TextFaint;
					            white-space: normal; word-break: break-all;">
						@DiscordButton.InviteUrl
					</div>
					<div style="font-size: 18px; font-weight: 700; padding: 12px 20px; border-radius: 10px;
					            margin-bottom: 22px; justify-content: center; cursor: pointer;
					            background-color: @WorldTheme.AccentBg; color: @WorldTheme.Text;
					            border-width: 2px; border-color: @WorldTheme.Border;"
					     onclick=@CopyDiscord>
						@DiscordLabel
					</div>

					<div style="font-size: 17px; font-weight: 800; letter-spacing: 1px; margin-bottom: 6px;
					            color: @WorldTheme.AccentCss;">
						OUR OTHER GAMES
					</div>
					<div style="font-size: 14px; margin-bottom: 8px; color: @WorldTheme.TextDim;">
						Everything we have published on s&amp;box, on one page.
					</div>
					<div style="font-size: 15px; margin-bottom: 10px; color: @WorldTheme.TextFaint;
					            white-space: normal; word-break: break-all;">
						@GamesButton.GamesUrl
					</div>
					<div style="font-size: 18px; font-weight: 700; padding: 12px 20px; border-radius: 10px;
					            margin-bottom: 22px; justify-content: center; cursor: pointer;
					            background-color: @WorldTheme.AccentBg; color: @WorldTheme.Text;
					            border-width: 2px; border-color: @WorldTheme.Border;"
					     onclick=@CopyGames>
						@GamesLabel
					</div>

					@* Credit for the soundtrack. Skafinity is its own open-source project that
					   this game installs as a library — it writes the alley's music live (N for
					   its board, M to mute) — so it belongs here with the other outbound links. *@
					<div style="font-size: 17px; font-weight: 800; letter-spacing: 1px; margin-bottom: 6px;
					            color: @WorldTheme.AccentCss;">
						MUSIC BY SKAFINITY
					</div>
					<div style="font-size: 14px; margin-bottom: 8px; color: @WorldTheme.TextDim;">
						The soundtrack is written as you play by Skafinity, an open-source s&amp;box library. Press N for its board, M to mute.
					</div>
					<div style="font-size: 15px; margin-bottom: 10px; color: @WorldTheme.TextFaint;
					            white-space: normal; word-break: break-all;">
						@SkafinityButton.SkafinityUrl
					</div>
					<div style="font-size: 18px; font-weight: 700; padding: 12px 20px; border-radius: 10px;
					            margin-bottom: 22px; justify-content: center; cursor: pointer;
					            background-color: @WorldTheme.AccentBg; color: @WorldTheme.Text;
					            border-width: 2px; border-color: @WorldTheme.Border;"
					     onclick=@CopySkafinity>
						@SkafinityLabel
					</div>

					<div style="font-size: 18px; font-weight: 700; padding: 10px 20px; border-radius: 10px;
					            justify-content: center; cursor: pointer;
					            background-color: @WorldTheme.Bg; color: @WorldTheme.TextDim;
					            border-width: 1px; border-color: @WorldTheme.Border;"
					     onclick=@Close>
						CLOSE
					</div>
				</div>
			</div>
		}
	}
</root>

@code
{
	private TerryAvatar LocalAvatar =>
		Scene?.GetAllComponents<TerryAvatar>().FirstOrDefault( a => a.IsValid() && !a.IsProxy );

	// Each link has its OWN "just copied" clock, so pressing one cannot flash the other's
	// confirmation. The label is the confirmation — there is no separate toast here, unlike the
	// lobby games, because this screen is already the thing the player is looking at.
	private string DiscordLabel => DiscordButton.SinceCopied < 2f
		? "✓  Discord invite copied to clipboard"
		: "Copy the Discord invite";

	private string GamesLabel => GamesButton.SinceCopied < 2f
		? "✓  link copied to clipboard"
		: "Copy the link to our games";

	private string SkafinityLabel => SkafinityButton.SinceCopied < 2f
		? "✓  link copied to clipboard"
		: "Copy the link to Skafinity";

	private void CopyDiscord() => DiscordButton.Copy();

	private void CopyGames() => GamesButton.Copy();

	private void CopySkafinity() => SkafinityButton.Copy();

	private void Close() => LocalAvatar?.RequestCloseMore();

	protected override int BuildHash()
	{
		var me = LocalAvatar;
		// Every copy clock is in the hash, or a label would only flip when something else moved.
		return System.HashCode.Combine( me?.NearMore ?? false, me?.MoreOpen ?? false,
			WorldTheme.Hash, DiscordButton.SinceCopied < 2f, GamesButton.SinceCopied < 2f,
			SkafinityButton.SinceCopied < 2f );
	}
}
