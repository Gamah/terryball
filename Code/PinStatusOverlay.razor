@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using System.Collections.Generic;
@using Terryball;
@inherits PanelComponent

@*
	Top-left corner status stack. Two first-party cards in a column: the pin-status rack (reads the
	GameDirector's live per-pin scoring — the same "tipped or knocked off its spot" test a modern alley's
	pin camera uses — head pin at top, back row at the bottom, green for standing, red for down) and,
	under it, the ball-speed readout: the bowling-scale mph LATCHED as the ball crossed the blue throw
	line and HELD until the next throw (BallController.ThrowLineMph), not the live velocity.
*@

<root style="position: absolute; top: 24px; left: 24px; flex-direction: column; align-items: stretch;
             font-family: Poppins, sans-serif; color: white;">
	@{
		var director = Director;
		var down = director?.DownCount ?? 0;
		var watching = director?.State == GameDirector.RoundState.Watching;
		var mph = Lane.ForLocalPlayer( Scene )?.Ball?.ThrowLineMph ?? 0f;
	}

	<div style="flex-direction: column; align-items: center; padding: 16px 20px;
	            background-color: rgba(0,0,0,0.62); border-radius: 10px;">
		<div style="font-size: 20px; font-weight: 700; margin-bottom: 2px;">
			@(watching ? "WATCHING" : "PINS")
		</div>
		<div style="font-size: 14px; color: rgba(255,255,255,0.7); margin-bottom: 12px;">
			@down up / @(10 - down) down
		</div>

		@foreach ( var row in GameDirector.RackRows )
		{
			<div style="flex-direction: row; justify-content: center;">
				@foreach ( var n in row )
				{
					var isDown = director?.IsPinDown( n ) ?? false;
					<div style="width: 26px; height: 26px; margin: 3px; border-radius: 13px;
					            align-items: center; justify-content: center; font-size: 12px;
					            font-weight: 600; color: @(isDown ? "rgba(255,255,255,0.55)" : "black");
					            background-color: @(isDown ? "#c0392b" : "#2ecc71");">
						@n
					</div>
				}
			</div>
		}
	</div>

	<div style="flex-direction: row; align-items: baseline; justify-content: center; margin-top: 10px;
	            padding: 12px 20px; background-color: rgba(0,0,0,0.62); border-radius: 10px;">
		<div style="font-size: 12px; font-weight: 700; letter-spacing: 1px;
		            color: rgba(255,255,255,0.55); margin-right: 10px;">SPEED</div>
		@if ( mph > 0.05f )
		{
			<div style="font-size: 30px; font-weight: 800; color: #6fd3ff;">@mph.ToString( "0.0" )</div>
			<div style="font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.6); margin-left: 4px;">mph</div>
		}
		else
		{
			<div style="font-size: 30px; font-weight: 800; color: rgba(255,255,255,0.35);">—</div>
		}
	</div>
</root>

@code
{
	// The rack layout (GameDirector.RackRows) and per-pin down state (director.IsPinDown) both live on
	// the director now, so this corner overlay and the big lane-width board above the backstop draw
	// from one source and can't disagree.
	private GameDirector Director => Lane.ForLocalPlayer( Scene )?.Director;

	// Rebuild whenever the round state, the set of downed pins, or the held throw-line speed changes.
	protected override int BuildHash()
	{
		var director = Director;
		var mask = 0;
		if ( director is not null )
			foreach ( var s in director.PinStatuses )
				if ( s.Down ) mask |= 1 << s.Number;
		var mph = Lane.ForLocalPlayer( Scene )?.Ball?.ThrowLineMph ?? 0f;
		return System.HashCode.Combine( director?.State, mask, System.MathF.Round( mph * 10f ) );
	}
}
