@using Sandbox;
@using Sandbox.UI;
@using System.Linq;
@using System.Collections.Generic;
@using Terryball;
@inherits PanelComponent

@*
	Top-left pin-status overlay. Reads the GameDirector's live per-pin scoring (same "tipped or
	knocked off its spot" test a modern alley's pin camera uses) and draws the ten pins as a rack
	triangle — head pin at top, back row at the bottom — green for standing, red for down.
*@

<root style="position: absolute; top: 24px; left: 24px; flex-direction: column;
             padding: 16px 20px; background-color: rgba(0,0,0,0.62); border-radius: 10px;
             font-family: Poppins, sans-serif; color: white; align-items: center;">
	@{
		var director = Director;
		var down = director?.DownCount ?? 0;
		var watching = director?.State == GameDirector.RoundState.Watching;
	}

	<div style="font-size: 20px; font-weight: 700; margin-bottom: 2px;">
		@(watching ? "WATCHING" : "PINS")
	</div>
	<div style="font-size: 14px; color: rgba(255,255,255,0.7); margin-bottom: 12px;">
		@down up / @(10 - down) down
	</div>

	@foreach ( var row in GameDirector.RackRows )
	{
		<div style="flex-direction: row; justify-content: center;">
			@foreach ( var n in row )
			{
				var isDown = director?.IsPinDown( n ) ?? false;
				<div style="width: 26px; height: 26px; margin: 3px; border-radius: 13px;
				            align-items: center; justify-content: center; font-size: 12px;
				            font-weight: 600; color: @(isDown ? "rgba(255,255,255,0.55)" : "black");
				            background-color: @(isDown ? "#c0392b" : "#2ecc71");">
					@n
				</div>
			}
		</div>
	}
</root>

@code
{
	// The rack layout (GameDirector.RackRows) and per-pin down state (director.IsPinDown) both live on
	// the director now, so this corner overlay and the big lane-width board above the backstop draw
	// from one source and can't disagree.
	private GameDirector Director => Scene?.GetAllComponents<GameDirector>().FirstOrDefault();

	// Rebuild whenever the round state or the set of downed pins changes.
	protected override int BuildHash()
	{
		var director = Director;
		var mask = 0;
		if ( director is not null )
			foreach ( var s in director.PinStatuses )
				if ( s.Down ) mask |= 1 << s.Number;
		return System.HashCode.Combine( director?.State, mask );
	}
}
