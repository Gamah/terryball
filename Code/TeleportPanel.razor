@using Sandbox
@using Sandbox.UI
@using System.Linq
@using System.Collections.Generic
@using Terryball
@inherits PanelComponent

@*
	The lane-teleport screen. Walking up to the TELEPORT podium on the spawn concourse and pressing E opens
	this (TerryAvatar runs the engage / cursor-free, like the other podiums). A button per lane whisks the
	local player to that lane's settee. Pointer-events: none except the modal + buttons, like LaneControls.
*@

<root style="position: absolute; width: 100%; height: 100%; pointer-events: none;
             font-family: Poppins, sans-serif; color: white;">
	@{
		var me = LocalAvatar;
	}

	@if ( me is not null )
	{
		@* Walk-up prompt: near the teleport podium but not engaged yet. *@
		@if ( me.NearTeleport && !me.TeleportOpen )
		{
			<div style="position: absolute; bottom: 64px; left: 0px; right: 0px;
			            flex-direction: row; justify-content: center;">
				<div style="font-size: 22px; font-weight: 700; padding: 10px 24px; border-radius: 10px;
				            background-color: rgba(8,10,16,0.82);
				            border-width: 1px; border-color: rgba(90,200,220,0.45);">
					Press <span style="color: #5ac8dc; font-weight: 800;">E</span> — Teleport to a Lane
				</div>
			</div>
		}

		@if ( me.TeleportOpen )
		{
			<div style="position: absolute; width: 100%; height: 100%;
			            flex-direction: column; align-items: center; justify-content: center;">
				<div style="pointer-events: all; flex-direction: column; width: 560px;
				            padding: 28px 32px; border-radius: 18px; background-color: rgba(8,10,16,0.97);
				            border-width: 2px; border-color: rgba(90,200,220,0.5);">

					<div style="font-size: 28px; font-weight: 800; letter-spacing: 1px; margin-bottom: 18px;">
						TELEPORT TO A LANE
					</div>

					<div style="flex-direction: column;">
						@for ( var i = 0; i < Lanes.Count; i++ )
						{
							var lane = Lanes[i];
							var n = i + 1;
							<div style="pointer-events: all; margin-bottom: 10px; padding: 14px 22px; border-radius: 10px;
							            font-size: 20px; font-weight: 700; cursor: pointer;
							            background-color: rgba(52,152,219,0.85);"
							     onclick=@( () => LocalAvatar?.TeleportToLane( lane ) )>
								Lane @n
							</div>
						}
						@if ( Lanes.Count == 0 )
						{
							<div style="font-size: 16px; color: rgba(255,255,255,0.5);">No lanes found.</div>
						}
					</div>

					<div style="flex-direction: row; margin-top: 8px;">
						<div style="flex-grow: 1;"></div>
						<div style="pointer-events: all; padding: 12px 26px; border-radius: 9px;
						            font-size: 17px; font-weight: 700; cursor: pointer;
						            background-color: rgba(255,255,255,0.12);"
						     onclick=@CloseTeleport>
							CLOSE (E)
						</div>
					</div>
				</div>
			</div>
		}
	}
</root>

@code
{
	private TerryAvatar LocalAvatar =>
		Scene?.GetAllComponents<TerryAvatar>().FirstOrDefault( a => a.IsValid() && !a.IsProxy );

	// All lanes in stable left-to-right (world-Y) order — matches the "Lane n" numbering elsewhere.
	private List<Lane> Lanes =>
		Scene?.GetAllComponents<Lane>().Where( l => l.IsValid() ).OrderBy( l => l.WorldPosition.y ).ToList() ?? new();

	private void CloseTeleport() => LocalAvatar?.RequestCloseTeleport();

	protected override int BuildHash()
	{
		var me = LocalAvatar;
		return System.HashCode.Combine( me?.NearTeleport ?? false, me?.TeleportOpen ?? false, Lanes.Count );
	}
}
