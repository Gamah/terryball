@using System;
@using Sandbox;
@using Sandbox.UI;
@using Terryball;
@inherits PanelComponent

@*
	Chat is the ENGINE'S overlay — it draws the message feed AND provides the typing box, opened with
	the "Chat" action (Enter). The "which key opens chat" hint is in HudHints.

	This panel draws NOTHING and exists only for the IsOpen stub below, which the gameplay input gates
	compile against.
*@

<root></root>

<style>
	root {
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
</style>

@code
{
	/// <summary>Read by the gameplay input-gates (BallCamera look, MusicScreen keys, GameDirector's G).
	/// The built-in chat overlay captures input itself while you type, so there's no game-side box to be
	/// open — this stays false.</summary>
	public static bool IsOpen => false;

	protected override int BuildHash() => 0;
}
