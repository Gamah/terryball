@using Sandbox
@using Sandbox.UI
@using Terryball
@inherits PanelComponent

@*
	Paints the LaneMonitorCamera's live render target onto this settee screen — the right-hand
	overhead panel that "doubles" the active bowler's view. The texture updates its own pixels every
	frame (it's a render target), so we only need to point the panel background at it.

	The guided-throw ("Aim") LINE/AIM/POWER/SPIN meter that mirrors the active bowler's setup lives on a
	SEPARATE panel floating just above this board — see <c>AimFeedBanner</c> — so it reads ABOVE the shot
	instead of covering it. It can't simply be positioned off the top edge of THIS panel: a WorldPanel
	clips to its own surface (PanelSize), so anything outside those bounds is never rendered.
*@

<root style="width: 100%; height: 100%; background-color: black; background-size: cover;"></root>

@code
{
	private LaneMonitorCamera Source => Lane.Of( this )?.Monitor;

	protected override void OnUpdate()
	{
		base.OnUpdate();

		var feed = Source?.Feed;
		if ( Panel is not null && feed is not null )
			Panel.Style.BackgroundImage = feed;
	}
}
