@using Sandbox;
@using Sandbox.UI;
@using Terryball;
@inherits PanelComponent

@*
	The local bowler's on-screen controls while riding the ball. Right now that's just the escape
	hatch: a button-styled prompt for the G key, which ends your turn (drops you back to the settee)
	for when the director gets wedged mid-turn.

	It's deliberately pointer-events: none — an interactive screen panel flips the engine into UI input
	mode while you're aiming, which zeroes AnalogLook and freezes the ball camera. So this is a visible
	affordance and the action lives on the G key (which works while the mouse is captured for aiming).
*@

<root>
	@{
		var director = Director;
		var bowling = director?.LocalIsBowling ?? false;
	}
	@if ( bowling )
	{
		<div class="bail">
			<div class="key">G</div>
			<div class="label">Exit ball</div>
		</div>
	}
	else
	{
		<div class="respawn">
			<div class="key">R</div>
			<div class="label">Respawn</div>
		</div>
	}
</root>

<style>
	root {
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.bail {
		position: absolute;
		top: 24px;
		right: 24px;
		flex-direction: row;
		align-items: center;
		gap: 10px;
		padding: 10px 16px;
		background-color: rgba(120, 30, 30, 0.78);
		border: 1px solid rgba(255, 180, 180, 0.5);
		border-radius: 8px;
		font-family: Poppins, sans-serif;
		color: white;
		pointer-events: none;
	}

	.bail .label {
		font-size: 17px;
		font-weight: 600;
	}

	.bail .key {
		font-size: 14px;
		font-weight: 700;
		color: rgba(0, 0, 0, 0.8);
		background-color: rgba(255, 255, 255, 0.85);
		padding: 1px 8px;
		border-radius: 5px;
	}

	/* Persistent respawn affordance while walking — a quiet chip, bottom-left, out of the way of the
	   music hints (bottom-right) and the bowling exit chip (top-right). The key itself is handled in
	   TerryAvatar; this is just the prompt. */
	.respawn {
		position: absolute;
		left: 16px;
		bottom: 16px;
		flex-direction: row;
		align-items: center;
		gap: 8px;
		font-size: 14px;
		color: rgba(255, 165, 0, 0.85);
		text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.8);
		pointer-events: none;
	}

	.respawn .label {
		font-weight: 600;
	}

	.respawn .key {
		font-size: 13px;
		font-weight: 700;
		color: rgba(0, 0, 0, 0.8);
		background-color: rgba(255, 255, 255, 0.85);
		padding: 1px 8px;
		border-radius: 5px;
	}
</style>

@code
{
	// The HUD is client-local (not under a lane), so it shows the lane the local player has joined.
	private GameDirector Director => Lane.ForLocalPlayer( Scene )?.Director;

	protected override int BuildHash() => System.HashCode.Combine( Director?.LocalIsBowling ?? false );
}
