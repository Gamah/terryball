@using Sandbox
@using Sandbox.UI
@using System.Linq
@using System.Collections.Generic
@using Terryball
@inherits PanelComponent

@*
	The lane controls — a screen-space overlay the director owns (spawned on its HUD). Walking up to the
	settee podium and pressing E opens a CENTERED modal that shows the scoreboard AND the controls
	(JOIN/LEAVE, host START/STOP, CLOSE). The whole tree is pointer-events: none EXCEPT the modal box and
	its buttons (pointer-events: all) — that's what lets the freed cursor actually click them (plain
	ScreenPanel input, the same pattern as rotaliate's settings screen). Engage state + cursor live on
	the local TerryAvatar.
*@

<root style="position: absolute; width: 100%; height: 100%; pointer-events: none;
             font-family: Poppins, sans-serif; color: white;">
	@{
		var director = Director;
		var me = LocalAvatar;
		var playing = director?.Phase == GameDirector.GamePhase.Playing;
		var over = director?.GameOver ?? false;
	}

	@if ( director is not null )
	{
		@* Walk-up prompt: near the podium but not engaged yet. *@
		@if ( me is not null && me.NearStation && !me.ControlsOpen )
		{
			<div style="position: absolute; bottom: 64px; left: 0px; right: 0px;
			            flex-direction: row; justify-content: center;">
				<div style="font-size: 22px; font-weight: 700; padding: 10px 24px; border-radius: 10px;
				            background-color: rgba(8,10,16,0.82);
				            border-width: 1px; border-color: rgba(120,160,220,0.4);">
					Press <span style="color: #f1c40f; font-weight: 800;">E</span> — Lane Controls
				</div>
			</div>
		}

		@* Centered modal while engaged (cursor is freed). pointer-events: all on the box + buttons. *@
		@if ( me is not null && me.ControlsOpen )
		{
			<div style="position: absolute; width: 100%; height: 100%;
			            flex-direction: column; align-items: center; justify-content: center;">
				<div style="pointer-events: all; flex-direction: column; width: 1120px;
				            padding: 26px 30px; border-radius: 18px; background-color: rgba(8,10,16,0.97);
				            border-width: 2px; border-color: rgba(120,160,220,0.5);">

					@* Header: title + game state. *@
					<div style="flex-direction: row; align-items: center; margin-bottom: 16px;">
						<div style="font-size: 30px; font-weight: 800; flex-grow: 1; letter-spacing: 6px;">
							LANE <span style="color: #5aa0e6;">@LaneNumber</span> CONTROLS
						</div>
						@* Throw mode — a lane-wide setting (every bowler on the lane rolls the same way). Shown in the
						   LOBBY too: there it's a LOCAL pending pick (see ToggleAim) that gets written when you press
						   START and claim the lane — it never grabs the director off a bare toggle, which is what broke
						   joining before (commit 7292bf3). Once you run the lane it writes straight through. *@
						@if ( CanDirect || !playing )
						{
							<div style="pointer-events: all; margin-right: 16px; padding: 8px 16px; border-radius: 8px;
							            font-size: 15px; font-weight: 700; cursor: pointer;
							            border-width: 1px; border-color: rgba(120,160,220,0.4);
							            background-color: @(AimOn ? "rgba(155,89,182,0.20)" : "rgba(255,255,255,0.06)");"
							     onclick=@ToggleAim>
								Throw: <span style="color: @(AimOn ? "#b07cd6" : "#5aa0e6");">@(AimOn ? "AIM" : "FREE")</span>
							</div>
						}
						@* Ball Crane — same lane-wide setting; shown in the lobby as a local pending pick alongside the
						   throw toggle, applied on START. *@
						@if ( CanDirect || !playing )
						{
							<div style="pointer-events: all; margin-right: 16px; padding: 8px 16px; border-radius: 8px;
							            font-size: 15px; font-weight: 700; cursor: pointer;
							            border-width: 1px; border-color: rgba(120,160,220,0.4);
							            background-color: @(CraneOn ? "rgba(46,204,113,0.18)" : "rgba(255,255,255,0.06)");"
							     onclick=@ToggleCrane>
								Ball Crane: <span style="color: @(CraneOn ? "#2ecc71" : "rgba(255,255,255,0.55)");">@(CraneOn ? "ON" : "OFF")</span>
							</div>
						}
						@* Mode tier — the lane-wide experience (Play = the 10-frame game, Practice = a live queue with
						   per-turn drills). Same lobby-pending pattern as the throw/crane toggles: a director writes
						   straight through SetMode, a lobby joiner stashes a local pick (see PickMode) applied on START.
						   Rendered as a segmented control that iterates the enum, so future modes slot in for free. *@
						@if ( CanDirect || !playing )
						{
							<div style="flex-direction: row; align-items: center; margin-right: 16px; padding: 3px;
							            border-radius: 8px; border-width: 1px; border-color: rgba(120,160,220,0.4);
							            background-color: rgba(255,255,255,0.06);">
								@foreach ( var m in ModeTiers )
								{
									var on = ModeOn == m;
									<div style="pointer-events: all; padding: 5px 12px; border-radius: 6px;
									            font-size: 15px; font-weight: 700; cursor: pointer;
									            background-color: @(on ? "rgba(52,152,219,0.28)" : "transparent");
									            color: @(on ? "#5aa0e6" : "rgba(255,255,255,0.55)");"
									     onclick=@(() => PickMode( m ))>
										@ModeLabel( m )
									</div>
								}
							</div>
						}
						@* Drill selector — a lane-wide setting for what the rack looks like each practice turn. Only shown
						   in Practice; same pending pattern (see PickDrill), routed through SetDrill. *@
						@if ( (CanDirect || !playing) && ModeOn == GameDirector.LaneMode.Practice )
						{
							<div style="flex-direction: row; align-items: center; margin-right: 16px; padding: 3px;
							            border-radius: 8px; border-width: 1px; border-color: rgba(155,89,182,0.4);
							            background-color: rgba(255,255,255,0.06);">
								@foreach ( var dr in DrillTiers )
								{
									var on = DrillOn == dr;
									<div style="pointer-events: all; padding: 5px 10px; border-radius: 6px;
									            font-size: 14px; font-weight: 700; cursor: pointer;
									            background-color: @(on ? "rgba(155,89,182,0.24)" : "transparent");
									            color: @(on ? "#b07cd6" : "rgba(255,255,255,0.55)");"
									     onclick=@(() => PickDrill( dr ))>
										@dr.ToString()
									</div>
								}
							</div>
						}
						<div style="font-size: 18px; font-weight: 700;
						            color: @(over ? "#f1c40f" : "rgba(255,255,255,0.6)");">
							@(over ? "GAME OVER" : (playing ? (UpName + " is up") : ("LOBBY — " + JoinedCount + " joined")))
						</div>
					</div>

					@* Scoreboard area. In Practice the scorecard is moot: swap the frame grid for a PRACTICE MODE
					   banner + the live throw queue (front of queue = current bowler, highlighted). Play renders the
					   grid below unchanged. *@
					@if ( ModeOn == GameDirector.LaneMode.Practice )
					{
						<div style="flex-direction: column; margin-bottom: 18px;">
							<div style="flex-direction: row; align-items: center; margin-bottom: 10px;">
								<div style="font-size: 22px; font-weight: 800; letter-spacing: 4px; color: #b07cd6;
								            padding: 8px 16px; border-radius: 8px;
								            background-color: rgba(155,89,182,0.16);
								            border-width: 1px; border-color: rgba(155,89,182,0.4);">
									PRACTICE MODE
								</div>
								<div style="flex-grow: 1;"></div>
								<div style="font-size: 15px; font-weight: 700; color: rgba(255,255,255,0.55);
								            align-items: center;">
									<span>Drill: </span><span style="color: #b07cd6;">@DrillOn.ToString().ToUpper()</span>
								</div>
							</div>
							<div style="font-size: 13px; color: rgba(255,255,255,0.4); margin-bottom: 8px;
							            letter-spacing: 2px;">THROW QUEUE</div>
							@{ var queue = QueueNames; }
							@if ( queue.Count == 0 )
							{
								<div style="font-size: 16px; color: rgba(255,255,255,0.5); padding: 8px 4px;">
									No one queued yet — JOIN, then press START to open practice.
								</div>
							}
							else
							{
								@for ( var qi = 0; qi < queue.Count; qi++ )
								{
									var current = qi == CurrentQueueIndex;
									<div style="flex-direction: row; align-items: center; margin-bottom: 4px;
									            padding: 6px 12px; border-radius: 6px;
									            background-color: @(current ? "rgba(241,196,15,0.14)" : "rgba(255,255,255,0.03)");">
										<div style="width: 34px; font-size: 15px; font-weight: 800;
										            color: @(current ? "#f1c40f" : "rgba(255,255,255,0.45)");">@(qi + 1)</div>
										<div style="flex-grow: 1; font-size: 17px; font-weight: 700;
										            color: @(current ? "#f1c40f" : "white");">@queue[qi]</div>
										@if ( current )
										{
											<div style="font-size: 12px; font-weight: 800; letter-spacing: 2px;
											            color: #f1c40f;">UP</div>
										}
									</div>
								}
							}
						</div>
					}
					else
					{
					@* Scoreboard for every bowler. *@
					<div style="flex-direction: column; margin-bottom: 18px;">
						@foreach ( var p in Players )
						{
							<div style="flex-direction: row; align-items: stretch; margin-bottom: 6px;
							            background-color: @(p.Active ? "rgba(241,196,15,0.12)" : "rgba(255,255,255,0.03)");
							            border-radius: 6px; padding: 3px;">

								<div style="width: 150px; justify-content: center; padding-left: 10px;
								            font-size: 17px; font-weight: 700;">@p.Name</div>

								@for ( var fr = 0; fr < p.Frames.Count; fr++ )
								{
									var frame = p.Frames[fr];
									var tenth = fr == 9;
									<div style="flex-direction: column; width: @(tenth ? "66px" : "46px");
									            border-left-width: 1px; border-color: rgba(255,255,255,0.15);
									            background-color: @(frame.Active ? "rgba(241,196,15,0.20)" : "transparent");">
										<div style="font-size: 10px; color: rgba(255,255,255,0.4);
										            align-items: center; justify-content: center;">@(fr + 1)</div>
										<div style="flex-direction: row; justify-content: flex-end; padding: 0px 3px;">
											@foreach ( var mark in frame.Balls )
											{
												<div style="width: 18px; height: 18px; margin-left: 1px;
												            align-items: center; justify-content: center;
												            font-size: 13px; font-weight: 700;
												            border-width: 1px; border-color: rgba(255,255,255,0.16);">@mark</div>
											}
										</div>
										<div style="height: 22px; align-items: center; justify-content: center;
										            font-size: 15px; font-weight: 700;">
											@(frame.Score.HasValue ? frame.Score.Value.ToString() : "")
										</div>
									</div>
								}

								<div style="width: 62px; flex-direction: column; align-items: center;
								            justify-content: center; padding-left: 8px;">
									<div style="font-size: 9px; color: rgba(255,255,255,0.4);">TOTAL</div>
									<div style="font-size: 18px; font-weight: 800;">@p.Total</div>
								</div>
							</div>
						}
						@if ( Players.Count == 0 )
						{
							<div style="font-size: 16px; color: rgba(255,255,255,0.5); padding: 10px 4px;">
								No bowlers yet — JOIN, then press START to run this lane.
							</div>
						}
					</div>
					}

					@* Buttons. Game actions (START / STOP / RESET) on the LEFT; JOIN/LEAVE sits on the RIGHT next
					   to CLOSE. *@
					<div style="flex-direction: row; align-items: center;">
						@* START: any player at the lobby can begin a game — it CLAIMS this lane's director so
						   they run it. STOP/RESET: only the player who claimed the lane (its director-owner). *@
						@if ( !playing )
						{
							<div style="pointer-events: all; margin-right: 12px; padding: 12px 28px; border-radius: 9px;
							            font-size: 18px; font-weight: 700; cursor: pointer; background-color: rgba(52,152,219,0.9);"
							     onclick=@StartAndApply>
								START
							</div>
						}
						else if ( CanDirect )
						{
							<div style="pointer-events: all; margin-right: 12px; padding: 12px 28px; border-radius: 9px;
							            font-size: 18px; font-weight: 700; cursor: pointer; background-color: rgba(155,89,182,0.9);"
							     onclick=@(() => director.StopGame())>
								STOP
							</div>
							@* RESET: wipe the current game's scores and start over from frame 1 with the same roster. *@
							<div style="pointer-events: all; margin-right: 12px; padding: 12px 28px; border-radius: 9px;
							            font-size: 18px; font-weight: 700; cursor: pointer; background-color: rgba(230,126,34,0.9);"
							     onclick=@(() => director.ResetGame())>
								RESET
							</div>
						}
						<div style="flex-grow: 1;"></div>
						@if ( me is not null && !playing )
						{
							<div style="pointer-events: all; margin-right: 12px; padding: 12px 28px; border-radius: 9px;
							            font-size: 18px; font-weight: 700; cursor: pointer;
							            background-color: @(me.Joined ? "rgba(192,57,43,0.9)" : "rgba(46,204,113,0.9)");"
							     onclick=@ToggleJoin>
								@(me.Joined ? "LEAVE" : "JOIN")
							</div>
						}
						<div style="pointer-events: all; padding: 12px 28px; border-radius: 9px;
						            font-size: 18px; font-weight: 700; cursor: pointer;
						            background-color: rgba(255,255,255,0.12);"
						     onclick=@CloseControls>
							CLOSE (E)
						</div>
					</div>
				</div>
			</div>
		}
	}
</root>

@code
{
	// The HUD is client-local (not under a lane), so the controls act on the lane the local player has
	// walked up to / joined.
	private Lane ActiveLane => Lane.ForLocalPlayer( Scene );
	private GameDirector Director => ActiveLane?.Director;

	// Our own avatar is the one we own (not a proxy). Null briefly before it spawns.
	private TerryAvatar LocalAvatar =>
		Scene?.GetAllComponents<TerryAvatar>().FirstOrDefault( a => a.IsValid() && !a.IsProxy );

	private bool IsHost => Networking.IsHost;

	// 1-based number of the lane the local player is at, by stable scene order — so each of the N lanes'
	// controls shows the right "LANE n". Falls back to 1 before an avatar/lane resolves.
	private int LaneNumber
	{
		get
		{
			var lane = ActiveLane;
			if ( lane is null ) return 1;
			var lanes = Scene.GetAllComponents<Lane>()
				.Where( l => l.IsValid() )
				.OrderBy( l => l.WorldPosition.y )
				.ToList();
			var idx = lanes.FindIndex( l => l == lane );
			return idx < 0 ? 1 : idx + 1;
		}
	}

	// Does the LOCAL player run this lane (show STOP / crane toggle)? True once they've claimed the lane by
	// pressing START; in the lobby the host is the default director.
	private bool CanDirect => Director?.LocalIsDirector ?? false;

	// Count only players joined to THIS lane (the one the local player is at), so the lobby tally is
	// per-lane with N alleys.
	private int JoinedCount
	{
		get
		{
			var laneId = ActiveLane?.GameObject.Id ?? System.Guid.Empty;
			if ( laneId == System.Guid.Empty ) return 0;
			return Scene?.GetAllComponents<TerryAvatar>()
				.Count( a => a.IsValid() && a.Joined && a.JoinedLaneId == laneId ) ?? 0;
		}
	}

	private List<GameDirector.PlayerView> Players => Director?.BuildScoreView() ?? new();

	private string UpName
	{
		get
		{
			var d = Director;
			if ( d is null || d.CurrentPlayer < 0 || d.CurrentPlayer >= d.RosterNames.Count ) return "";
			return d.RosterNames[d.CurrentPlayer];
		}
	}

	private void ToggleJoin()
	{
		var me = LocalAvatar;
		if ( me is null ) return;
		if ( me.Joined )
		{
			// Leave: clear both the flag and the lane assignment.
			me.Joined = false;
			me.JoinedLaneId = System.Guid.Empty;
		}
		else
		{
			// Join the lane we're walked up to (the station's lane). No station → nothing to join.
			var lane = me.ActiveLane;
			if ( lane is null ) return;
			me.JoinedLaneId = lane.GameObject.Id;
			me.Joined = true;
		}
	}

	// Lobby pre-game picks: in the lobby the host owns the director, so a joiner can't write AimMode/CraneEnabled
	// (and grabbing ownership off a toggle broke joining). Instead we stash the choice locally and apply it in
	// StartAndApply once START has claimed the lane. Null = "no local override, show the lane's current value".
	private bool? _pendingAim;
	private bool? _pendingCrane;
	private GameDirector.LaneMode? _pendingMode;
	private GameDirector.PracticeDrill? _pendingDrill;

	// The mode tier + drill options, iterated to render the segmented selectors — new enum members slot in
	// with no razor change.
	private static readonly GameDirector.LaneMode[] ModeTiers =
		(GameDirector.LaneMode[])System.Enum.GetValues( typeof( GameDirector.LaneMode ) );
	private static readonly GameDirector.PracticeDrill[] DrillTiers =
		(GameDirector.PracticeDrill[])System.Enum.GetValues( typeof( GameDirector.PracticeDrill ) );
	private static string ModeLabel( GameDirector.LaneMode m ) => m.ToString().ToUpper();

	// Mode tier pick — same shape as the throw/crane toggles: a director writes straight through to the synced
	// Mode; in the lobby it records a local pending pick applied on START. Display falls back to the lane's live
	// value. Defaults Play.
	private GameDirector.LaneMode ModeOn => _pendingMode ?? (Director?.Mode ?? GameDirector.LaneMode.Play);
	private void PickMode( GameDirector.LaneMode m )
	{
		var d = Director;
		if ( d is null ) return;
		if ( d.IsDirector ) { d.SetMode( m ); _pendingMode = null; }
		else _pendingMode = m; // lobby: local pick, applied on START
	}

	// Drill pick — same pattern; only meaningful in Practice. Defaults Regular.
	private GameDirector.PracticeDrill DrillOn => _pendingDrill ?? (Director?.Drill ?? GameDirector.PracticeDrill.Regular);
	private void PickDrill( GameDirector.PracticeDrill dr )
	{
		var d = Director;
		if ( d is null ) return;
		if ( d.IsDirector ) { d.SetDrill( dr ); _pendingDrill = null; }
		else _pendingDrill = dr; // lobby: local pick, applied on START
	}

	// Practice throw queue — reuses the roster machinery (front of queue = CurrentPlayer).
	private List<string> QueueNames => Director?.RosterNames?.ToList() ?? new();
	private int CurrentQueueIndex => Director?.CurrentPlayer ?? 0;

	// Throw-mode toggle. Once you run the lane (director) it writes straight through to the synced AimMode; in the
	// lobby it just records a local pending pick. Display falls back to the lane's live value. Defaults FREE.
	private bool AimOn => _pendingAim ?? (Director?.AimMode ?? false);
	private void ToggleAim()
	{
		var d = Director;
		if ( d is null ) return;
		if ( d.IsDirector ) { d.SetAimMode( !d.AimMode ); _pendingAim = null; }
		else _pendingAim = !AimOn; // lobby: local pick, applied on START
	}

	// Ball Crane toggle: same pattern as the throw toggle. Defaults ON.
	private bool CraneOn => _pendingCrane ?? (Director?.CraneEnabled ?? true);
	private void ToggleCrane()
	{
		var d = Director;
		if ( d is null ) return;
		if ( d.IsDirector ) { d.SetCraneEnabled( !d.CraneEnabled ); _pendingCrane = null; }
		else _pendingCrane = !CraneOn; // lobby: local pick, applied on START
	}

	// START: claim + begin the game, then flush any lobby picks now that we own the lane (StartGame claims the
	// director synchronously, so IsDirector is true here on success). Clears the pending picks either way.
	private void StartAndApply()
	{
		var d = Director;
		if ( d is null ) return;
		d.StartGame();
		if ( d.IsDirector )
		{
			if ( _pendingAim.HasValue ) d.SetAimMode( _pendingAim.Value );
			if ( _pendingCrane.HasValue ) d.SetCraneEnabled( _pendingCrane.Value );
			if ( _pendingMode.HasValue ) d.SetMode( _pendingMode.Value );
			if ( _pendingDrill.HasValue ) d.SetDrill( _pendingDrill.Value );
		}
		_pendingAim = null;
		_pendingCrane = null;
		_pendingMode = null;
		_pendingDrill = null;
	}

	// CLOSE button: hand back to the avatar so it restores look + cursor exactly like pressing E.
	private void CloseControls() => LocalAvatar?.RequestCloseControls();

	protected override int BuildHash()
	{
		var d = Director;
		var me = LocalAvatar;
		var hash = new System.HashCode();
		hash.Add( d?.Phase );
		hash.Add( d?.GameOver );
		hash.Add( d?.CurrentPlayer );
		hash.Add( JoinedCount );
		hash.Add( me?.Joined );
		hash.Add( IsHost );
		hash.Add( CanDirect );
		hash.Add( me?.NearStation );
		hash.Add( me?.ControlsOpen );
		hash.Add( d?.CraneEnabled );
		hash.Add( d?.AimMode );
		hash.Add( AimOn );
		hash.Add( CraneOn );
		hash.Add( d?.Mode );
		hash.Add( d?.Drill );
		hash.Add( ModeOn );
		hash.Add( DrillOn );
		foreach ( var name in QueueNames )
			hash.Add( name );
		foreach ( var p in Players )
		{
			hash.Add( p.Name );
			hash.Add( p.Active );
			hash.Add( p.Total );
			foreach ( var frame in p.Frames )
			{
				hash.Add( frame.Score );
				foreach ( var mark in frame.Balls )
					hash.Add( mark );
			}
		}
		return hash.ToHashCode();
	}
}
