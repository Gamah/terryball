@using Sandbox
@using Sandbox.UI
@using System.Linq
@using Terryball
@inherits PanelComponent

@*
	The world-settings screen. Walking up to the SETTINGS podium on the spawn concourse and pressing E opens
	this (TerryAvatar runs the engage / cursor-free, like the other podiums). Picks the world theme colour,
	which every in-world panel derives its chrome from (WorldTheme). Client-local and cookie-backed
	(WorldPrefs) — this changes YOUR alley, never anybody else's.

	This screen is themed from WorldTheme too, so picking a swatch recolours the picker under the cursor —
	which is the point: you see the theme before you walk away from the podium. Pointer-events: none except
	the modal + its cells, like LaneControls/TeleportPanel.
*@

<root style="position: absolute; width: 100%; height: 100%; pointer-events: none;
             font-family: Poppins, sans-serif; color: white;">
	@{
		var me = LocalAvatar;
	}

	@if ( me is not null )
	{
		@* Walk-up prompt: near the world podium but not engaged yet. *@
		@if ( me.NearWorldSettings && !me.WorldSettingsOpen )
		{
			<div style="position: absolute; bottom: 64px; left: 0px; right: 0px;
			            flex-direction: row; justify-content: center;">
				<div style="font-size: 22px; font-weight: 700; padding: 10px 24px; border-radius: 10px;
				            background-color: @WorldTheme.Bg;
				            border-width: 1px; border-color: @WorldTheme.Border;">
					Press <span style="color: @WorldTheme.AccentCss; font-weight: 800;">E</span> — World Settings
				</div>
			</div>
		}

		@if ( me.WorldSettingsOpen )
		{
			<div style="position: absolute; width: 100%; height: 100%;
			            flex-direction: column; align-items: center; justify-content: center;">
				<div style="pointer-events: all; flex-direction: column; width: 620px;
				            padding: 28px 32px; border-radius: 18px;
				            background-color: @WorldTheme.BgSolid;
				            border-width: 2px; border-color: @WorldTheme.Border;">

					<div style="font-size: 28px; font-weight: 800; letter-spacing: 1px; margin-bottom: 6px;
					            color: @WorldTheme.Text;">
						WORLD SETTINGS
					</div>
					<div style="font-size: 15px; margin-bottom: 20px; color: @WorldTheme.TextFaint;">
						Yours only — these are saved on this machine and never sent to the other players.
					</div>

					<div style="font-size: 17px; font-weight: 800; letter-spacing: 1px; margin-bottom: 10px;
					            color: @WorldTheme.AccentCss;">
						THEME COLOUR
					</div>
					<div style="font-size: 14px; margin-bottom: 14px; color: @WorldTheme.TextDim;">
						Tints the alley's panels, signs and read-outs. AUTO is the house amber.
					</div>

					@* AUTO + one cell per named swatch. The selected cell wears an accent border. *@
					<div style="flex-direction: row; flex-wrap: wrap; margin-bottom: 6px;">
						<div style="pointer-events: all; cursor: pointer;
						            flex-direction: row; align-items: center;
						            margin-right: 10px; margin-bottom: 10px;
						            padding: 10px 18px; border-radius: 10px;
						            font-size: 16px; font-weight: 700;
						            background-color: @(WorldPrefs.ThemeIsAuto ? WorldTheme.AccentBg : WorldTheme.Cell);
						            border-width: 2px;
						            border-color: @(WorldPrefs.ThemeIsAuto ? WorldTheme.AccentCss : "rgba(255,255,255,0.10)");
						            color: @WorldTheme.Text;"
						     onclick=@( () => Pick( "" ) )>
							AUTO
						</div>

						@foreach ( var (label, hex) in WorldPrefs.Swatches )
						{
							var selected = !WorldPrefs.ThemeIsAuto
								&& string.Equals( hex, WorldPrefs.ThemeColor, System.StringComparison.OrdinalIgnoreCase );

							<div style="pointer-events: all; cursor: pointer;
							            flex-direction: row; align-items: center;
							            margin-right: 10px; margin-bottom: 10px;
							            padding: 10px 18px; border-radius: 10px;
							            font-size: 16px; font-weight: 700;
							            background-color: @(selected ? WorldTheme.AccentBg : WorldTheme.Cell);
							            border-width: 2px;
							            border-color: @(selected ? WorldTheme.AccentCss : "rgba(255,255,255,0.10)");
							            color: @WorldTheme.Text;"
							     onclick=@( () => Pick( hex ) )>
								<div style="width: 18px; height: 18px; border-radius: 5px; margin-right: 10px;
								            background-color: @hex;"></div>
								@label
							</div>
						}
					</div>

					<div style="height: 2px; margin: 12px 0px; background-color: @WorldTheme.Divider;"></div>

					<div style="font-size: 17px; font-weight: 800; letter-spacing: 1px; margin-bottom: 4px;
					            color: @WorldTheme.AccentCss;">
						SKY BRIGHTNESS — @Pct( WorldPrefs.SkyBrightness )%
					</div>
					<div style="font-size: 14px; margin-bottom: 8px; color: @WorldTheme.TextDim;">
						Dims or lifts the daylight over the alley. 100% is the lighting as built.
					</div>
					<SliderControl class="wslider" Min="@WorldPrefs.SkyBrightnessMin" Max="@WorldPrefs.SkyBrightnessMax"
					               Step="@(0.01f)" Value="@WorldPrefs.SkyBrightness" ShowValueTooltip="@(false)"
					               OnValueChanged="@SetSkyBrightness"></SliderControl>

					<div style="height: 2px; margin: 12px 0px; background-color: @WorldTheme.Divider;"></div>

					<div style="font-size: 17px; font-weight: 800; letter-spacing: 1px; margin-bottom: 4px;
					            color: @WorldTheme.AccentCss;">
						VOICE RANGE — ROAMING — @( $"{WorldPrefs.VoiceRangeRoaming:0}u" )
					</div>
					<div style="font-size: 14px; margin-bottom: 8px; color: @WorldTheme.TextDim;">
						How far you hear other players talk. Your ears only — it doesn't change how far
						anybody hears you.
					</div>
					<SliderControl class="wslider" Min="@WorldPrefs.VoiceRangeMin" Max="@WorldPrefs.VoiceRangeMax"
					               Step="@(10f)" Value="@WorldPrefs.VoiceRangeRoaming" ShowValueTooltip="@(false)"
					               OnValueChanged="@SetVoiceRange"></SliderControl>

					<div style="height: 2px; margin: 12px 0px; background-color: @WorldTheme.Divider;"></div>

					<div style="flex-direction: row; align-items: center;">
						<div style="flex-grow: 1;"></div>
						<div style="pointer-events: all; padding: 12px 26px; border-radius: 9px;
						            font-size: 17px; font-weight: 700; cursor: pointer;
						            background-color: rgba(255,255,255,0.12); color: @WorldTheme.Text;"
						     onclick=@Close>
							CLOSE (E)
						</div>
					</div>
				</div>
			</div>
		}
	}
</root>

@*
	The ONLY compiled styles on this screen: the slider's layout. Every colour stays inline above because a
	compiled block is baked at build time and cannot follow the runtime theme — see WorldTheme. SliderControl
	brings its own chrome from the engine's base stylesheet, so all it needs here is a size and pointer input.
*@
<style>
	.wslider {
		width: 100%;
		height: 24px;
		margin-bottom: 4px;
		pointer-events: all;
	}

	/* Belt and braces with ShowValueTooltip="false": the built-in bubble renders as a bare black box
	   (hardcoded background in the base scss) and the heading above already prints the value. */
	.wslider .value-tooltip {
		display: none;
	}
</style>

@code
{
	private TerryAvatar LocalAvatar =>
		Scene?.GetAllComponents<TerryAvatar>().FirstOrDefault( a => a.IsValid() && !a.IsProxy );

	// Write the cookie and let every themed panel re-render off WorldTheme.Hash. There is nothing else to
	// notify: no panel caches a colour, they all read the static at build time.
	private void Pick( string hex ) => WorldPrefs.ThemeColor = hex;

	// The sliders write straight through to the cookie on every change — the store is tiny, and a drag's
	// worth of writes is what gambit's sliders do too. WorldPrefs bumps its Revision on each, which is what
	// re-renders this screen (so the heading's number tracks the thumb) and what the appliers watch.
	private void SetSkyBrightness( float v ) => WorldPrefs.SkyBrightness = v;
	private void SetVoiceRange( float v ) => WorldPrefs.VoiceRangeRoaming = v;

	private static int Pct( float v ) => (int)System.MathF.Round( v * 100f );

	private void Close() => LocalAvatar?.RequestCloseWorldSettings();

	protected override int BuildHash()
	{
		var me = LocalAvatar;
		return System.HashCode.Combine( me?.NearWorldSettings ?? false, me?.WorldSettingsOpen ?? false,
			WorldTheme.Hash, WorldPrefs.Revision );
	}
}
