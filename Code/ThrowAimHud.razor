@using Sandbox;
@using Sandbox.UI;
@using Terryball;
@inherits PanelComponent

@*
	The guided-throw ("Aim" mode) step meter — a real first-party HUD panel at the bottom-centre of the
	screen (no world overlay). It renders the live state published by the client-local ThrowAimer on the
	same object: the current step name, a caret sweeping a track, the sweet-spot tick(s) on POWER/SPIN, a
	centre reference on the directional steps, four step pips, the ghost tracks of the already-committed
	steps, and the commit/step-back hints. Once the throw's away it freezes on the committed values (no
	interaction hints) until the ball crosses the throw line and the sequence tears down.

	The caret sweeps every frame (its Left is set in OnUpdate); the rest of the tree only rebuilds when the
	step changes or the HUD shows/hides. pointer-events:none throughout, so it never grabs the cursor from
	aiming (an interactive screen panel would flip the engine into UI-input mode and freeze the ball camera).
*@

<root>
	@{
		var aimer = Aimer;
		var show = aimer?.AimHudVisible ?? false;
	}
	@if ( show )
	{
		var step = aimer.AimStep;
		var twoSided = aimer.AimTwoSided;
		var sweet = aimer.AimSweet01;
		var committed = aimer.AimCommitted;
		var ghosts = aimer.AimGhosts;
		var hint = committed
			? "Nice throw!"
			: (sweet >= 0f ? "Click / Space to set  ·  line up the tick (past it = overcooked)" : "Click / Space to set");
		<div class="dock">
			<div class="meter">
				<div class="title">@aimer.AimStepLabel</div>
				@* Already-committed steps, drawn as dimmed ghost tracks above the live one (oldest at top). *@
				@if ( ghosts.Count > 0 )
				{
					<div class="ghosts">
						@foreach ( var g in ghosts )
						{
							<div class="grow">
								<div class="glabel">@g.Label</div>
								<div class="gtrack">
									@if ( g.HasCenter )
									{
										<div class="gcenter"></div>
									}
									<div class="gcaret" style="left: @((g.Caret01 * 100f))%;"></div>
								</div>
							</div>
						}
					</div>
				}
				<div class="track">
					@* Centre reference for the directional steps (lane centre / straight aim / no hook). *@
					@if ( twoSided || sweet < 0f )
					{
						<div class="center"></div>
					}
					@* Sweet-spot tick(s): one on POWER, mirrored either side of centre on SPIN. *@
					@if ( twoSided )
					{
						<div class="sweet" style="left: @(((1f - sweet) * 50f))%;"></div>
						<div class="sweet" style="left: @(((1f + sweet) * 50f))%;"></div>
					}
					else if ( sweet >= 0f )
					{
						<div class="sweet" style="left: @((sweet * 100f))%;"></div>
					}
					<div class="caret" @ref="_caret"></div>
				</div>
				<div class="pips">
					@for ( int i = 0; i < 4; i++ )
					{
						<div class="pip @(i < step ? "on" : "")"></div>
					}
				</div>
				<div class="hint">@hint</div>
				@if ( !committed )
				{
					<div class="hint back">Right-click / Backspace to step back</div>
				}
			</div>
		</div>
	}
</root>

<style>
	/* Full-screen transparent passthrough; the card is centred at the bottom by an absolute full-width row
	   (.dock, left:0/right:0 + justify-content:center) — the project's proven bottom-centre pattern (see
	   TeleportPanel/HowToPlay). Sizing/centring the root panel itself directly is unreliable. */
	root {
		width: 100%;
		height: 100%;
		pointer-events: none;
		font-family: Poppins, sans-serif;
	}

	.dock {
		position: absolute;
		left: 0px;
		right: 0px;
		bottom: 48px;
		flex-direction: row;
		justify-content: center;
		pointer-events: none;
	}

	.meter {
		width: 460px;
		flex-direction: column;
		align-items: center;
		padding: 12px 20px;
		background-color: rgba(0, 0, 0, 0.62);
		border-radius: 12px;
		pointer-events: none;
	}

	.title {
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 1px;
		color: white;
		margin-bottom: 10px;
	}

	/* Ghost stack: the already-committed steps, shown above the live meter as dimmed mini-tracks so you can
	   read back what you locked in (LINE, then AIM, then POWER as you progress). */
	.ghosts {
		width: 100%;
		flex-direction: column;
		gap: 5px;
		margin-bottom: 10px;
	}

	.grow {
		flex-direction: row;
		align-items: center;
		gap: 8px;
		opacity: 0.55;
	}

	.glabel {
		width: 52px;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 1px;
		color: rgba(255, 255, 255, 0.75);
	}

	.gtrack {
		flex-grow: 1;
		height: 7px;
		background-color: rgba(46, 51, 64, 0.9);
		border-radius: 4px;
		position: relative;
	}

	.gcenter {
		position: absolute;
		left: 50%;
		margin-left: -1px;
		top: 1px;
		bottom: 1px;
		width: 2px;
		background-color: rgba(255, 255, 255, 0.22);
	}

	.gcaret {
		position: absolute;
		margin-left: -2px;
		top: -2px;
		bottom: -2px;
		width: 4px;
		border-radius: 2px;
		background-color: rgb(90, 200, 255);
	}

	.track {
		width: 100%;
		height: 16px;
		background-color: rgba(46, 51, 64, 0.95);
		border-radius: 8px;
		position: relative;
	}

	.center {
		position: absolute;
		left: 50%;
		margin-left: -1px;
		top: 2px;
		bottom: 2px;
		width: 2px;
		background-color: rgba(255, 255, 255, 0.28);
	}

	.sweet {
		position: absolute;
		margin-left: -2px;
		top: -3px;
		bottom: -3px;
		width: 4px;
		border-radius: 2px;
		background-color: rgba(255, 255, 255, 0.9);
	}

	.caret {
		position: absolute;
		left: 0%;
		margin-left: -3px;
		top: -4px;
		bottom: -4px;
		width: 6px;
		border-radius: 3px;
		background-color: rgb(90, 200, 255);
		box-shadow: 0px 0px 8px 1px rgba(90, 200, 255, 0.8);
	}

	.pips {
		flex-direction: row;
		gap: 9px;
		margin-top: 12px;
	}

	.pip {
		width: 9px;
		height: 9px;
		border-radius: 5px;
		background-color: rgba(70, 76, 92, 1);
	}

	.pip.on {
		background-color: rgb(90, 200, 255);
	}

	.hint {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.7);
		margin-top: 10px;
	}

	/* Step-back hint: same colour as the primary hint, just a touch smaller and tighter under it. */
	.hint.back {
		font-size: 11px;
		color: rgba(255, 255, 255, 0.7);
		margin-top: 3px;
	}
</style>

@code
{
	private Panel _caret;

	// ThrowAimer lives on the same client-local HUD object; it publishes the live step state we render.
	private ThrowAimer Aimer => Components.Get<ThrowAimer>();

	// Only rebuild the tree when the HUD shows/hides, the step changes, or the throw commits — the caret sweep
	// is set per-frame in OnUpdate below, so the continuous motion doesn't churn the panel.
	protected override int BuildHash()
	{
		var a = Aimer;
		var hc = new System.HashCode();
		hc.Add( a?.AimHudVisible ?? false );
		hc.Add( a?.AimStep ?? 0 );
		hc.Add( a?.AimCommitted ?? false );
		// Ghost tracks are static once built, so fold their locked positions in too — that way re-locking a step
		// after stepping back (same step count, new caret) still rebuilds the ghost markers.
		if ( a is not null )
			foreach ( var g in a.AimGhosts ) { hc.Add( g.Label ); hc.Add( g.Caret01 ); }
		return hc.ToHashCode();
	}

	protected override void OnUpdate()
	{
		var a = Aimer;
		if ( a is not null && a.AimHudVisible && _caret is { IsValid: true, IsDeleting: false } )
			_caret.Style.Left = Length.Fraction( a.AimCaret01 );
	}
}
